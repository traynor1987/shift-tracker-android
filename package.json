{
  "name": "dominos-shift-tracker",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run typecheck && npm run build && node --experimental-strip-types --test tests/*.test.mjs && node --experimental-strip-types --test tests/*.test.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "typecheck": "tsc --noEmit --incremental false",
    "types:generate": "bash scripts/sites-env.sh -- wrangler types worker-configuration.d.ts --config scripts/worker-types.config.json --env-interface CloudflareEnv && node scripts/scope-worker-types.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.20",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.7",
    "fake-indexeddb": "^6.2.4",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.1",
    "wrangler": "4.144.0"
  },
  "type": "module",
  "displayName": "Domino\u2019s Shift Tracker",
  "overrides": {
    "image-size": "2.0.3",
    "esbuild": "0.28.1"
  }
}
