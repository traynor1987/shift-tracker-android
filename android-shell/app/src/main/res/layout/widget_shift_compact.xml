<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/compact_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background_compact" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:contentDescription="Shift Tracker" android:src="@mipmap/shift_tracker_launcher" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="9dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/compact_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="CLOCKED OUT" android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
        <Chronometer android:id="@+id/compact_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/compact_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#D9ECFF" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_red_pill" android:paddingHorizontal="7dp" android:paddingVertical="4dp" android:text="LIVE" android:textColor="#FFFFFFFF" android:textSize="8sp" android:textStyle="bold" />
</LinearLayout>
